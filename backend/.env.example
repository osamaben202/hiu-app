# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiu_app
DB_USER=postgres
DB_PASSWORD=postgres

# JWT密钥
JWT_SECRET=hiu-app-secret-key-2024-change-in-production

# CORS
CORS_ORIGIN=*

# 声网配置
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# AWS S3配置
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hiu-app
